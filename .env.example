# Telegram Bot Configuration
# 1. Message @BotFather on Telegram and send /newbot to create your bot and get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Your Channel ID (e.g. -1004370492757) or User ID. You can also specify multiple IDs separated by commas!
TELEGRAM_CHAT_ID=-1004370492757

# Notification Settings
# Minimum discount percentage to trigger a discount alert (default: 1.0)
MIN_DISCOUNT_PERCENT=1.0

# Alert Toggles (true/false)
NOTIFY_NEW_LISTINGS=true
NOTIFY_RESTOCKS=true
NOTIFY_DISCOUNTS=true

# Polling interval in seconds when running in daemon mode (default: 120)
CHECK_INTERVAL_SECONDS=120

# Whether to scan all products across the entire store (true/false, default: false)
SCAN_ALL_PRODUCTS=false
