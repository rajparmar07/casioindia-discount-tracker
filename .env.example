# Telegram Bot Configuration
# 1. Message @BotFather on Telegram and send /newbot to create your bot and get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Message @userinfobot on Telegram to get your numeric Telegram ID
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional Settings:
# Minimum discount percentage to trigger an alert (e.g., 10 for 10% or more off)
MIN_DISCOUNT_PERCENT=5

# Polling interval in seconds when running in daemon mode (e.g. 120 for 2 minutes)
CHECK_INTERVAL_SECONDS=120

# Whether to scan all products across the entire store (true/false, default: false for faster scans)
SCAN_ALL_PRODUCTS=false
